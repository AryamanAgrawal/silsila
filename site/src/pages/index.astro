---
import Base from "@/layouts/Base.astro";
import ProgramNav from "@/components/ProgramNav.astro";
import Hero from "@/components/Hero.astro";
import Marquee from "@/components/Marquee.astro";
import Statement from "@/components/Statement.astro";
import Host from "@/components/Host.astro";
import RunOfShow from "@/components/RunOfShow.astro";
import Artists from "@/components/Artists.astro";
import Listen from "@/components/Listen.astro";
import StayInTouch from "@/components/StayInTouch.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { event, formatted, addressLine } from "@/data/event";

const details = [
  { strong: `${formatted.weekday} ${formatted.dayNumber} ${formatted.month} ${formatted.year}` },
  { strong: "Doors", dim: formatted.doors },
  { strong: "Curtain", dim: formatted.showtime },
  { strong: event.venue.name, dim: event.venue.room },
  { strong: addressLine },
  { strong: event.venue.neighbourhood },
];

---

{/*
  Field sequence. A sindoor marquee only ever sits between two bone sections.
  Plaster no longer runs as a single act: it carries the evening and the
  artists, then returns once at the end, so the maroon bookends the programme
  rather than alternating in and out of it.

    bone → sindoor → bone bone → PLASTER PLASTER → bone → PLASTER → bone

  Statement and Host are adjacent on purpose: silsila is continuation written
  as poetry, Ruh's line is the same idea written as purpose. Host takes the
  warm bone ground so the two still read as separate sections.

  The lineup marquee that used to sit before the venue section is gone with it:
  it was the only bone section left between that marquee and Stay in touch, and
  without it the two sindoor blocks merged into one slab of red. It belongs
  back here the moment another bone section returns to this stretch.
*/}
<Base>
  <ProgramNav />
  <Hero />
  <Marquee items={details} speed={38} />
  <main id="main">
    <Statement />
    <Host />
    <RunOfShow />
    <Artists />
    <Listen />
    <StayInTouch />
  </main>
  <SiteFooter />

  <script>
    import "@/scripts/motion";
  </script>
</Base>
