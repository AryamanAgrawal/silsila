---
import { thanks } from "@/data/event";
import { asset } from "@/lib/url";

/**
 * Sits between the album and the closing panel: the last thing the programme
 * says before it asks anyone to follow along.
 *
 * A supporter wall is set as a wall — names at one weight, in one grid, none
 * larger than another. Logos replace names in place as they arrive.
 */
---

<section class="field field--bone section thanks" id="thanks" aria-labelledby="thanks-h">
  <div class="wrap">
    <p class="kicker">With gratitude</p>
    <h2 class="section-title" id="thanks-h">Thank you</h2>

    <p class="lede">This evening was made by many hands.</p>

    <ul class="orgs">
      {
        thanks.organisations.map((o) => (
          <li>
            {o.logo ? (
              <img src={asset(o.logo)} alt={o.name} loading="lazy" />
            ) : (
              <span>{o.name}</span>
            )}
          </li>
        ))
      }
    </ul>

    <div class="people">
      <p class="meta">And to</p>
      <p class="names">{thanks.people.join(" · ")}</p>
    </div>
  </div>
</section>

<style>
  .thanks .lede {
    margin-top: var(--s3);
  }

  .orgs {
    list-style: none;
    margin: clamp(var(--s8), 5vw, var(--s12)) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: var(--s6) var(--s8);
    border-top: 1px solid var(--hairline);
    padding-top: clamp(var(--s6), 4vw, var(--s8));
  }
  .orgs li {
    display: flex;
    align-items: center;
    min-height: 44px;
  }
  /* One weight, one size: a supporter wall that ranks its supporters is a
     league table, not a thank you. */
  .orgs span {
    font-family: var(--f-serif);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    color: var(--strong);
    line-height: 1.2;
  }
  .orgs img {
    max-height: 52px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    /* levels a wall of mismatched logos onto one ink */
    filter: grayscale(1) contrast(1.05);
    opacity: 0.86;
  }

  .people {
    margin-top: clamp(var(--s8), 5vw, var(--s12));
    border-top: 1px solid var(--hairline);
    padding-top: clamp(var(--s6), 4vw, var(--s8));
  }
  .names {
    margin: var(--s2) 0 0;
    font-family: var(--f-sign);
    font-size: clamp(1.4rem, 3.4vw, 2.1rem);
    line-height: 1.3;
    color: var(--plaster);
  }
</style>
