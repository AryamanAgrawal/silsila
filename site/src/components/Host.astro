---
import { host, event } from "@/data/event";
import { asset } from "@/lib/url";

/**
 * Sits directly under the statement, which is also a bone field, so it takes
 * the warm bone ground and a rule at the top: without them the two run
 * together and the page reads as one very long section.
 *
 * On a phone the mark pairs with the heading as a letterhead rather than
 * standing alone above it — a 240px mark on its own line left a hole between
 * the statement's signature and the first word of the mission.
 *
 * Uses the calligraphy on its own, not the lockup: at this size the lockup's
 * wordmark is illegible, and the name is set beside it in full anyway.
 */
---

<section class="field field--bone section host" id="host" aria-labelledby="host-h">
  <div class="wrap">
    <div class="head">
      <img
        class="mark"
        src={asset(event.host.mark)}
        alt=""
        aria-hidden="true"
        width="900"
        height="641"
        loading="lazy"
      />
      <div class="titles">
        <p class="kicker">The host</p>
        <h2 class="section-title" id="host-h">{host.name}</h2>
      </div>
    </div>

    <div class="copy">
      {host.bio.map((p) => <p class="body">{p}</p>)}
    </div>
  </div>
</section>

<style>
  .host {
    background: var(--bone-warm);
    border-top: 1px solid var(--hairline);
  }

  .head {
    display: flex;
    align-items: center;
    gap: clamp(var(--s4), 4vw, var(--s8));
  }
  .mark {
    width: clamp(72px, 17vw, 116px);
    height: auto;
    flex: none;
  }
  .titles .section-title {
    margin-bottom: 0;
  }

  .copy {
    margin-top: clamp(var(--s6), 4vw, var(--s8));
  }
  .body {
    font-family: var(--f-serif);
    font-weight: 300;
    font-size: clamp(1.1rem, 2.4vw, 1.5rem);
    line-height: 1.5;
    max-width: 54ch;
    margin: 0;
  }
  /* Past 720px the mark can stand on its own beside the whole block again. */
  @media (min-width: 720px) {
    .wrap {
      display: grid;
      grid-template-columns: minmax(0, 200px) 1fr;
      gap: clamp(var(--s8), 6vw, var(--s24));
      align-items: start;
    }
    .head {
      display: contents;
    }
    .mark {
      width: 100%;
      grid-row: span 2;
    }
    .copy {
      margin-top: var(--s4);
    }
  }
</style>
