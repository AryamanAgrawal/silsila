---
import { event, addressLine, formatted } from "@/data/event";
---

<footer class="field field--bone footer">
  <div class="wrap">
    <div class="grid">
      <div>
        <p class="mark">{event.series}</p>
        <p class="sub">{event.title}</p>
      </div>

      <dl class="cols">
        <div>
          <dt>When</dt>
          <dd>{formatted.weekday} {formatted.dayNumber} {formatted.month} {formatted.year}</dd>
          <dd>Doors {formatted.doors} · Curtain {formatted.showtime}</dd>
        </div>
        <div>
          <dt>Where</dt>
          <dd>{event.venue.name}, {event.venue.room}</dd>
          <dd>{addressLine}</dd>
        </div>
        <div>
          <dt>Contact</dt>
          <dd><a href={`mailto:${event.contact.email}`}>{event.contact.email}</a></dd>
          <dd><a href={`tel:${event.contact.phone.replace(/\D/g, "")}`}>{event.contact.phone}</a></dd>
        </div>
      </dl>
    </div>

    <p class="credit">Presented by {event.presentedBy}</p>
  </div>
  <div class="checker"></div>
</footer>

<style>
  .footer {
    padding-top: clamp(var(--s16), 8vw, var(--s24));
  }
  .grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(var(--s8), 6vw, var(--s24));
    align-items: start;
  }
  @media (max-width: 780px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  .mark {
    font-family: var(--f-formal);
    font-size: var(--t-49);
    line-height: 0.9;
    margin: 0;
    color: var(--ink);
  }
  .sub {
    font-family: var(--f-display);
    text-transform: uppercase;
    font-size: var(--t-20);
    letter-spacing: 0.02em;
    color: var(--sindoor);
    margin: 0;
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: var(--s6);
    margin: 0;
  }
  .cols dt {
    font-size: var(--t-12);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ash);
    margin-bottom: var(--s2);
  }
  .cols dd {
    margin: 0 0 4px;
    font-size: var(--t-14);
  }
  .cols a {
    color: var(--sindoor);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  .credit {
    font-family: var(--f-sign);
    font-size: var(--t-25);
    color: var(--plaster);
    margin: clamp(var(--s12), 6vw, var(--s16)) 0 clamp(var(--s12), 6vw, var(--s16));
    line-height: 1;
  }
</style>
