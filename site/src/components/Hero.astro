---
import { event, formatted } from "@/data/event";

/** "South Asian" is a compound adjective and must not break across lines. */
const taglineDisplay = event.tagline.replace("South Asian", "South\u00A0Asian");

/** 11 tarab strings, as on the instrument. */
const STRINGS = Array.from({ length: 11 }, (_, i) => i);
---

<header class="field field--bone hero" id="top">
  <div class="checker"></div>

  <svg
    class="strings"
    viewBox="0 0 1000 420"
    preserveAspectRatio="none"
    aria-hidden="true"
    data-strings
  >
    {
      STRINGS.map((i) => (
        <path
          class="string"
          data-string={i}
          d={`M0 ${26 + i * 37} Q500 ${26 + i * 37} 1000 ${26 + i * 37}`}
          data-base={26 + i * 37}
        />
      ))
    }
  </svg>

  <div class="wrap hero-inner">
    <div class="lockup">
      <h1 class="title" data-anim="sam">{event.title}</h1>
      <span class="series" aria-hidden="true" data-anim="script">{event.series}</span>
      <span class="sr-only">{event.series}</span>
    </div>

    <p class="tagline">{taglineDisplay}</p>

    <dl class="facts">
      <div>
        <dt>Date</dt>
        <dd>
          {formatted.weekday}
          <b>{formatted.dayNumber} {formatted.month}</b>
          {formatted.year}
        </dd>
      </div>
      <div>
        <dt>Time</dt>
        <dd>Doors <b>{formatted.doors}</b> · Curtain <b>{formatted.showtime}</b></dd>
      </div>
      <div>
        <dt>Venue</dt>
        <dd><b>{event.venue.name}</b> · {event.venue.room}</dd>
      </div>
    </dl>

    <div class="cta">
      <a class="btn btn--primary" href={event.tickets.url ?? "#tickets"} data-magnetic>
        Book tickets
      </a>
    </div>
  </div>
</header>

<style>
  .hero {
    padding-bottom: clamp(var(--s16), 8vw, var(--s32));
    overflow: hidden;
  }
  .hero-inner {
    padding-top: clamp(var(--s16), 9vw, var(--s32));
    text-align: center;
  }

  .strings {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 0.5;
  }
  .string {
    fill: none;
    stroke: var(--ink);
    stroke-width: 0.6;
    opacity: 0.16;
  }

  .lockup {
    position: relative;
    display: inline-block;
    max-width: 100%;
  }
  .title {
    font-family: var(--f-display);
    font-weight: 400;
    text-transform: uppercase;
    font-size: var(--t-hero);
    line-height: 0.82;
    letter-spacing: -0.012em;
    color: var(--sindoor);
    margin: 0;
  }
  .series {
    font-family: var(--f-formal);
    font-size: var(--t-script);
    color: var(--ink);
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translate(-50%, 34%);
    white-space: nowrap;
    line-height: 1;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .tagline {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.015em;
    font-size: clamp(0.82rem, 2.1vw, 1.32rem);
    margin: clamp(var(--s12), 7vw, var(--s16)) auto 0;
    /* Balance only engages once the line actually wraps; without it the mobile
       break orphans "MUSIC" on a line of its own. */
    text-wrap: balance;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s4) clamp(var(--s6), 5vw, var(--s16));
    margin: var(--s8) 0 0;
  }
  .facts > div {
    text-align: center;
  }
  .facts dt {
    font-size: var(--t-12);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ash);
    margin-bottom: 2px;
  }
  .facts dd {
    margin: 0;
    font-size: var(--t-14);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .facts b {
    font-weight: 700;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
    justify-content: center;
    margin-top: clamp(var(--s8), 5vw, var(--s12));
  }

  @media (max-width: 560px) {
    .cta .btn {
      flex: 1 1 100%;
    }
  }
</style>
