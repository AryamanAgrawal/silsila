---
import { event, formatted } from "@/data/event";
import { asset } from "@/lib/url";

/** "South Asian" is a compound adjective and must not break across lines. */
const taglineDisplay = event.tagline.replace("South Asian", "South Asian");

/** 11 tarab strings, as on the instrument. */
const STRINGS = Array.from({ length: 11 }, (_, i) => i);

/**
 * One line, not a three-column table. This is a program cover: the detail is
 * stated once here and properly in the venue section, and the reader's next
 * move is down the page rather than out to a checkout.
 */
const standfirst = [
  `${formatted.weekday} ${formatted.dayNumber} ${formatted.month} ${formatted.year}`,
  `Doors ${formatted.doors} · ${formatted.showtime}`,
  `${event.venue.name}`,
];
---

<header class="field field--bone hero" id="top">
  <div class="checker"></div>

  <svg
    class="strings"
    viewBox="0 0 1000 420"
    preserveAspectRatio="none"
    aria-hidden="true"
    data-strings
  >
    {
      STRINGS.map((i) => (
        <path
          class="string"
          data-string={i}
          d={`M0 ${26 + i * 37} Q500 ${26 + i * 37} 1000 ${26 + i * 37}`}
          data-base={26 + i * 37}
        />
      ))
    }
  </svg>

  <div class="wrap hero-inner">
    <a class="host" href="#host">
      <img
        src={asset(event.host.mark)}
        alt=""
        aria-hidden="true"
        width="900"
        height="641"
        fetchpriority="high"
      />
      <span>Presented by {event.host.name}</span>
    </a>

    <div class="lockup">
      <h1 class="title" data-anim="sam">{event.title}</h1>
      <span class="series" aria-hidden="true" data-anim="script">{event.series}</span>
      <span class="sr-only">{event.series}</span>
    </div>

    <p class="tagline">{taglineDisplay}</p>

    <p class="standfirst">
      {standfirst.map((bit, i) => (
        <>
          {i > 0 && <span class="sep" aria-hidden="true">—</span>}
          <span>{bit}</span>
        </>
      ))}
    </p>
  </div>
</header>

<style>
  .hero {
    padding-bottom: clamp(var(--s12), 6vw, var(--s24));
    overflow: hidden;
  }
  .hero-inner {
    padding-top: clamp(var(--s8), 5vw, var(--s16));
    text-align: center;
  }

  .strings {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 0.5;
  }
  .string {
    fill: none;
    stroke: var(--ink);
    stroke-width: 0.6;
    opacity: 0.16;
  }

  /* The host is credited above the title, quietly, the way a program does it. */
  .host {
    display: inline-flex;
    align-items: center;
    gap: var(--s3);
    text-decoration: none;
    color: var(--ash);
    margin-bottom: clamp(var(--s6), 4vw, var(--s8));
  }
  .host img {
    width: clamp(38px, 8vw, 54px);
    height: auto;
  }
  .host span {
    font-size: var(--t-12);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-align: left;
  }
  .host:hover span {
    color: var(--sindoor);
  }

  .lockup {
    position: relative;
    display: inline-block;
    max-width: 100%;
  }
  .title {
    font-family: var(--f-display);
    font-weight: 400;
    text-transform: uppercase;
    font-size: var(--t-hero);
    line-height: 0.82;
    letter-spacing: -0.012em;
    color: var(--sindoor);
    margin: 0;
  }
  .series {
    font-family: var(--f-formal);
    font-size: var(--t-script);
    color: var(--ink);
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translate(-50%, 34%);
    white-space: nowrap;
    line-height: 1;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .tagline {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.015em;
    font-size: clamp(0.82rem, 2.1vw, 1.32rem);
    margin: clamp(var(--s12), 7vw, var(--s16)) auto 0;
    /* Balance only engages once the line actually wraps; without it the mobile
       break orphans "MUSIC" on a line of its own. */
    text-wrap: balance;
  }

  /* Stacked on a phone, where an inline run wraps and strands each em dash at
     the end of a line. The separators only appear once the three sit on one. */
  .standfirst {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    margin: var(--s6) auto 0;
    max-width: 40ch;
    font-size: var(--t-14);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ash);
  }
  .sep {
    display: none;
    color: var(--plaster);
  }
  @media (min-width: 720px) {
    .standfirst {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      align-items: baseline;
      gap: 0 var(--s3);
      max-width: none;
    }
    .sep {
      display: inline;
    }
  }
</style>
