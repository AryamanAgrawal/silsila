---
import { album } from "@/data/event";
---

<section class="field field--bone section listen" id="listen" aria-labelledby="listen-h">
  <div class="wrap grid">
    <div class="copy">
      <p class="kicker">Played live on the night</p>
      <h2 class="section-title" id="listen-h">{album.title}</h2>
      <p class="by">{album.artist}</p>
      <p class="blurb">{album.blurb}</p>

      <ol class="tracks">
        {album.tracks.map((t) => <li>{t}</li>)}
      </ol>

      <p class="meta runtime">{album.releaseYear} · {album.runtime} · {album.tracks.length} tracks</p>
    </div>

    <div class="player">
      <iframe
        src={`https://open.spotify.com/embed/album/${album.spotifyId}?theme=0`}
        width="100%"
        height="420"
        frameborder="0"
        loading="lazy"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        title={`${album.title} by ${album.artist} on Spotify`}></iframe>
      <a class="btn btn--ghost full" href={album.spotifyUrl} target="_blank" rel="noopener noreferrer">
        Open in Spotify
      </a>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(var(--s8), 6vw, var(--s24));
    align-items: start;
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  .by {
    font-family: var(--f-sign);
    font-size: var(--t-31);
    color: var(--accent);
    margin: 0 0 var(--s4);
    line-height: 1;
  }
  .blurb {
    max-width: 46ch;
    margin: 0;
  }

  .tracks {
    margin: var(--s8) 0 var(--s6);
    padding: 0;
    list-style: none;
    counter-reset: t;
    max-width: 42ch;
  }
  .tracks li {
    counter-increment: t;
    display: flex;
    gap: var(--s4);
    align-items: baseline;
    padding: 9px 0;
    border-bottom: 1px solid var(--hairline);
    font-family: var(--f-serif);
    font-size: var(--t-20);
    letter-spacing: 0.02em;
  }
  .tracks li::before {
    content: counter(t, decimal-leading-zero);
    font-family: var(--f-body);
    font-size: var(--t-12);
    letter-spacing: 0.14em;
    color: var(--muted);
  }
  .runtime {
    margin: 0;
  }

  .player iframe {
    border-radius: 0;
    display: block;
    background: rgba(0, 0, 0, 0.2);
  }
  .full {
    display: flex;
    width: 100%;
    margin-top: var(--s3);
  }
</style>
