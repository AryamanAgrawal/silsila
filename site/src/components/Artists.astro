---
import { artists } from "@/data/event";
import Polaroid from "./Polaroid.astro";

/**
 * A snap strip of polaroids over one bio panel, so a face and the words about
 * it are never more than a thumb apart. On a phone the strip scrolls and the
 * next card peeks in at the edge; past 900px all seven fit at once and it
 * reads as the wall it used to be.
 *
 * Every panel is rendered and visible on the server. `motion.ts` is what hides
 * the inactive ones, so with no JS the section degrades to a strip of
 * photographs above every bio in order.
 */
const CARD = 210;
---

<section class="field field--plaster section artists" id="artists" aria-labelledby="artists-h">
  <div class="wrap">
    <p class="kicker">On stage</p>
    <h2 class="section-title" id="artists-h">The artists</h2>
    <p class="lede">Seven musicians. Tap a photograph.</p>
  </div>

  <div class="strip-scroll" data-strip>
    <ul class="strip" role="tablist" aria-label="The artists">
      {
        artists.map((a, i) => (
          <li class="slot">
            <button
              class="pick"
              role="tab"
              type="button"
              id={`tab-${a.slug}`}
              aria-controls={`panel-${a.slug}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              data-pick={a.slug}
            >
              <Polaroid artist={a} width={CARD} seed={i + 1} />
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="wrap">
    <ol class="dots" data-dots aria-hidden="true">
      {artists.map((a) => <li data-dot={a.slug} />)}
    </ol>

    <div class="panels" data-panels>
      {
        artists.map((a, i) => (
          <article
            class="panel"
            role="tabpanel"
            id={`panel-${a.slug}`}
            aria-labelledby={`tab-${a.slug}`}
            data-panel={a.slug}
            data-active={i === 0 ? "true" : "false"}
          >
            <header class="p-head">
              <h3 class="p-name">
                {a.honorific && <em>{a.honorific}</em>}
                {a.name}
              </h3>
              <p class="p-inst">{a.instrument}</p>
            </header>

            {a.bio ? (
              a.bio.map((para) => <p class="p-text">{para}</p>)
            ) : (
              <p class="p-pending">A note on {a.name.split(" ")[0]} is on its way.</p>
            )}

            {a.press && (
              <ul class="press">
                {a.press.map((q) => (
                  <li>
                    <blockquote>{q.quote}</blockquote>
                    <cite>{q.source}</cite>
                  </li>
                ))}
              </ul>
            )}

            {a.links && (
              <p class="p-links">
                {a.links.map((l) => (
                  <a href={l.url} target="_blank" rel="noopener noreferrer">
                    {l.label}
                  </a>
                ))}
              </p>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .artists .lede {
    margin-top: var(--s3);
  }

  /* Full-bleed so cards can run to the screen edge and read as scrollable. */
  .strip-scroll {
    margin-top: clamp(var(--s12), 6vw, var(--s16));
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
  }
  .strip-scroll::-webkit-scrollbar {
    display: none;
  }

  .strip {
    --strip-gap: clamp(var(--s6), 4vw, var(--s12));
    display: flex;
    align-items: flex-start;
    gap: var(--strip-gap);
    list-style: none;
    margin: 0;
    /* The tape sits above the card and the cards are tilted, so the strip
       needs headroom and side room or both get clipped by the scroller. */
    padding: 26px var(--gutter) var(--s8);
    width: max-content;
    min-width: 100%;
    justify-content: center;
  }
  .slot {
    scroll-snap-align: center;
    flex: none;
  }

  /* Past 900px the strip stops being a strip: the cards give up whatever width
     is needed for all seven to stand on screen together, so the section reads
     as the wall it replaced and the scroll affordance is never offered where
     there is nothing to scroll. Capped at the mobile size so it never inflates
     on a very wide display. */
  @media (min-width: 900px) {
    .strip {
      --strip-gap: var(--s4);
    }
    .slot :global(.card) {
      width: min(210px, calc((100vw - 2 * var(--gutter) - 6 * var(--strip-gap)) / 7));
    }
  }

  .pick {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font: inherit;
    color: inherit;
    -webkit-tap-highlight-color: transparent;
    transition:
      transform 0.4s cubic-bezier(0.33, 1, 0.68, 1),
      opacity 0.4s;
  }
  /* Unpicked cards sit back a step. Held at 0.82 because the polaroid's white
     border blends toward the plaster underneath it, and much below this the
     card reads as pink rather than as unselected. Scale carries the rest. */
  .pick[aria-selected="false"] {
    opacity: 0.82;
    transform: scale(0.92);
  }
  .pick[aria-selected="true"] {
    opacity: 1;
    transform: scale(1);
  }
  .pick:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 6px;
  }

  .dots {
    display: flex;
    justify-content: center;
    gap: 9px;
    list-style: none;
    margin: 0 0 clamp(var(--s8), 5vw, var(--s12));
    padding: 0;
  }
  .dots li {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--hairline);
    transition:
      background-color 0.3s,
      transform 0.3s;
  }
  .dots li[data-on] {
    background: var(--strong);
    transform: scale(1.35);
  }
  @media (min-width: 900px) {
    .dots {
      display: none;
    }
  }

  .panels {
    max-width: 66ch;
    margin-inline: auto;
    border-top: 1px solid var(--hairline);
    padding-top: clamp(var(--s6), 4vw, var(--s8));
    /* Holds the floor steady so switching between a three-paragraph bio and a
       one-line placeholder does not bounce the page under the reader. */
    min-height: 20rem;
  }
  .panel[data-active="false"] {
    display: none;
  }

  .p-head {
    margin-bottom: var(--s4);
  }
  .p-name {
    font-family: var(--f-serif);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-size: clamp(1.35rem, 4vw, 2rem);
    line-height: 1.1;
    color: var(--strong);
    margin: 0;
  }
  .p-name em {
    font-style: normal;
    color: var(--muted);
    margin-right: 0.45em;
    font-size: 0.68em;
  }
  .p-inst {
    font-family: var(--f-sign);
    font-size: var(--t-25);
    color: var(--accent);
    line-height: 1;
    margin: 4px 0 0;
  }

  .p-text {
    margin: 0 0 var(--s4);
  }
  .p-pending {
    font-family: var(--f-serif);
    font-style: italic;
    font-size: var(--t-20);
    color: var(--muted);
    margin: 0;
  }

  .press {
    list-style: none;
    margin: var(--s6) 0 0;
    padding: 0;
    display: grid;
    gap: var(--s4);
  }
  .press blockquote {
    font-family: var(--f-serif);
    font-style: italic;
    font-size: var(--t-20);
    line-height: 1.4;
    margin: 0;
    color: var(--strong);
  }
  .press cite {
    font-style: normal;
    font-size: var(--t-12);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .p-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s4);
    margin: var(--s6) 0 0;
  }
  .p-links a {
    font-size: var(--t-12);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--link);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }

  /* No JS: the strip is still a strip, and every bio is simply on the page. */
  :global(html:not(.js)) .panel[data-active="false"] {
    display: block;
  }
  :global(html:not(.js)) .panels .panel + .panel {
    margin-top: var(--s8);
    border-top: 1px solid var(--hairline);
    padding-top: var(--s8);
  }
  :global(html:not(.js)) .pick[aria-selected="false"] {
    opacity: 1;
    transform: none;
  }
  :global(html:not(.js)) .dots {
    display: none;
  }
</style>
