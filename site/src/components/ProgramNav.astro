---
/**
 * Slim bar that appears once the hero is off screen. A program is not read
 * strictly top to bottom — someone in their seat wants the running order now,
 * and the artist they are watching a minute later.
 *
 * Rendered hidden and revealed by `motion.ts`, which also drives the active
 * mark. With no JS it simply never appears, and the page is still a page.
 */
const LINKS = [
  { id: "evening", label: "Evening" },
  { id: "artists", label: "Artists" },
  { id: "listen", label: "Listen" },
];
---

<nav class="bar" data-nav aria-label="Program sections" hidden>
  <a class="mark" href="#top" aria-label="Back to top">silsila</a>
  <ul>
    {
      LINKS.map((l) => (
        <li>
          <a href={`#${l.id}`} data-nav-link={l.id}>
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: var(--s4);
    padding: 9px var(--gutter);
    background: color-mix(in srgb, var(--bone) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(23, 23, 23, 0.14);
    /* No resting transform here on purpose. `motion.ts` sets yPercent the
       instant it unhides the bar, and GSAP would otherwise stack its percentage
       on top of this one — leaving "shown" parked at -100%. */
  }
  .bar[hidden] {
    display: none;
  }

  .mark {
    font-family: var(--f-formal);
    font-size: var(--t-25);
    line-height: 1;
    color: var(--ink);
    text-decoration: none;
    flex: none;
  }

  .bar ul {
    display: flex;
    align-items: center;
    gap: clamp(var(--s3), 3vw, var(--s8));
    list-style: none;
    margin: 0 0 0 auto;
    padding: 0;
    /* Four items fit a 320px phone; if a fifth is ever added this scrolls
       rather than wrapping the bar to two lines. */
    overflow-x: auto;
    scrollbar-width: none;
  }
  .bar ul::-webkit-scrollbar {
    display: none;
  }

  .bar a[data-nav-link] {
    display: block;
    padding: 4px 0;
    font-size: var(--t-12);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ash);
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition:
      color 0.25s,
      border-color 0.25s;
  }
  .bar a[data-nav-link][data-on] {
    color: var(--sindoor);
    border-bottom-color: var(--sindoor);
  }
  .bar a:hover {
    color: var(--sindoor);
  }

  @media (max-width: 400px) {
    .mark {
      font-size: var(--t-20);
    }
  }
</style>
